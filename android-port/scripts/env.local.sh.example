# Machine-specific settings for the android-port scripts. Copy to env.local.sh (git ignores it) and fill in.

# The toolbox folder: dotnet/, godot/, godot-templates/, keystore/ and Civ3/ (see android-port/README.md).
TOOLBOX="C:/dev/openciv3"
ANDROID_SDK="C:/dev/android-sdk"

# adb serials of the devices that deploy.sh knows by name (see "adb devices").
TABLET=
PIXEL=

# Signing key of the APK. Godot reads these variables; export_presets.cfg holds no key.
export GODOT_ANDROID_KEYSTORE_RELEASE_PATH="$TOOLBOX/keystore/openciv3android.keystore"
export GODOT_ANDROID_KEYSTORE_RELEASE_USER=
export GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=
